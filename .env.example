# ==============================================================================
# Foodiez Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database URL
# ------------------------------------------------------------------------------
# For Local Development (SQLite - Zero Setup):
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL - Vercel / Render / Supabase / Neon / Aiven):
# DATABASE_URL="postgresql://username:password@ep-host-123456.us-east-2.aws.neon.tech/foodiez?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth Authentication
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://your-app.vercel.app or https://your-app.onrender.com
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"
AUTH_SECRET="generate-a-strong-random-secret-here"

# ------------------------------------------------------------------------------
# 3. Google OAuth (Optional)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. Razorpay Payments (Optional)
# If not provided, Foodiez runs in Demo / COD Checkout Mode seamlessly!
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyId"
# RAZORPAY_KEY_ID="rzp_test_yourKeyId"
# RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"

# ------------------------------------------------------------------------------
# 5. Web3Forms Contact Form (Optional)
# ------------------------------------------------------------------------------
# Get your free access key at https://web3forms.com
# NEXT_PUBLIC_WEB3FORMS_KEY="your-web3forms-access-key"
